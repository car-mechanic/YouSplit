# Home-Assistant-Add-on: Frontend-Build + Backend in EINEM Container.
# Build aus dem Repo-Root:  docker build -f Dockerfile.addon -t yousplit-addon .

# --- Stufe 1: Frontend bauen ---
FROM node:22-alpine AS frontend
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# --- Stufe 2: Backend + fertiges Frontend ---
FROM python:3.12-slim-trixie
WORKDIR /app

# PostgreSQL läuft im selben Container (Daten in /data/postgres)
RUN apt-get update && apt-get install -y --no-install-recommends postgresql \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ /app/
COPY --from=frontend /build/dist /app/static
COPY yousplit/run.py /run.py

ENV STATIC_DIR=/app/static
EXPOSE 8099
CMD ["python", "/run.py"]
